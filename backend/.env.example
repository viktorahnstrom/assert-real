# Copy to /opt/assert-real/.env on the server. Never commit the real file.

# ── Deployment ───────────────────────────────────────────────────────────────
DOMAIN=assertreal.dev
ACME_EMAIL=you@example.com
IMAGE_TAG=latest

ENVIRONMENT=production
LOG_LEVEL=info

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── VLM provider ─────────────────────────────────────────────────────────────
# "google" is the cheapest of the three real providers.
VLM_DEFAULT_PROVIDER=google

VLM_MAX_REQUESTS_PER_DAY=100
VLM_MAX_MONTHLY_COST_USD=10.00

GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.0-flash
GOOGLE_GEMINI_TIMEOUT=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=30

# ── Public demo abuse controls ───────────────────────────────────────────────
MAX_UPLOAD_BYTES=26214400
RATE_LIMIT_ANALYSES=10/hour
RATE_LIMIT_DEFAULT=60/hour

# Disable the thesis user study router in production.
ENABLE_STUDY_ROUTER=false